{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {"src":"/(.*)","headers":{"Cross-Origin-Opener-Policy":"same-origin","Cross-Origin-Embedder-Policy":"require-corp"},"continue":true},
    {"src":"/sw\\.js","headers":{"Cache-Control":"no-cache"},"continue":true},
    {"src":"/api/engine/status/?","methods":["GET","HEAD"],"dest":"/cloud-status.json","headers":{"Cache-Control":"no-store"}},
    {"src":"/api/engine/analyze(?:/.*)?","status":503,"headers":{"Cache-Control":"no-store"}},
    {"handle":"filesystem"}
  ]
}
