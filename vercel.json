{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/engine/analyze.ts": {
      "regions": ["iad1"],
      "maxDuration": 30,
      "supportsCancellation": true,
      "includeFiles": "{public/eco.json,server/engine/wasm-worker.cjs,node_modules/stockfish/bin/stockfish-19-lite-single.*}"
    },
    "api/engine/status.ts": {
      "regions": ["iad1"],
      "maxDuration": 5
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
